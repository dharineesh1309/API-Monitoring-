      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (exposure) (centralwatch_api_exposure_apis{exposure=~\"public|unauthenticated\"})", "legendFormat": "{{exposure}}", "refId": "A" }

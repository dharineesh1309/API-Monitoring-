      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (event_type) (increase(centralwatch_centralwatch_security_violations_total[5m]))",
          "legendFormat": "{{event_type}}",

# ============================================================
# CentralWatch — REAL AWS environment template
# ============================================================
# Copy this file to the repo-root `.env` when running the production stack
# (docker-compose.aws.yml performs ${VAR} substitution from it), or to
# `demo-app/.env` when running the app directly with uvicorn.
#
#   cp .env.aws.example .env      # repo root (docker compose mode)
#   cp .env.aws.example demo-app/.env   # bare uvicorn mode
#
# Replace every <PLACEHOLDER> with your real values. NEVER commit the filled-in
# file — `.env` is gitignored. Full instructions: AWS_DEPLOYMENT.md.
#
# REQUIRED = must be set to a real value before the stack will work.
# OPTIONAL = may be left empty; the app / compose provides a safe default.
# NOTE: AUTH_TOKEN_SECRET and GRAFANA_ADMIN_PASSWORD have NO defaults — the AWS
# compose file (docker-compose.aws.yml) refuses to start without them.
# ============================================================

# --- Application ---
SERVICE_NAME=centralwatch-demo-app
SERVICE_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- AWS connection (REAL AWS) ---
# LEAVE EMPTY: boto3 resolves the regional default endpoints automatically
# from AWS_REGION. Do NOT put LocalStack or fake endpoints here.
AWS_ENDPOINT_URL=
AWS_REGION=<YOUR_AWS_REGION e.g. us-east-1>
# Empty => standard AWS credential chain (env, ~/.aws/credentials, ECS/EC2 role).
# Fill these only if you are passing static keys via the environment.
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_SESSION_TOKEN=
# "auto" is the SDK default — correct for real AWS (do not use "path").
AWS_S3_ADDRESSING_STYLE=auto
# Real AWS: the app VALIDATES resources at startup and fails fast; it never
# auto-creates anything. Keep false.
AWS_PROVISION_RESOURCES=false
# OPTIONAL - ARN of the Lambda execution role for centralwatch-image-processor.
# Only consumed when AWS_PROVISION_RESOURCES=true (provisioning mode). The
# real-AWS validate mode only needs lambda:GetFunction + lambda:InvokeFunction.
LAMBDA_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/centralwatch-lambda-execution

# --- AWS resources (must already exist; names must match what you created) ---
S3_BUCKET=<YOUR_S3_BUCKET e.g. centralwatch-files>
DYNAMODB_USERS_TABLE=<YOUR_USERS_TABLE e.g. users>
DYNAMODB_ORDERS_TABLE=<YOUR_ORDERS_TABLE e.g. orders>
DYNAMODB_FILES_TABLE=<YOUR_FILES_TABLE e.g. files>
SNS_TOPIC=<YOUR_SNS_TOPIC_NAME e.g. centralwatch-notifications>
SQS_QUEUE=<YOUR_SQS_QUEUE_NAME e.g. centralwatch-queue>
LAMBDA_FUNCTION=<YOUR_LAMBDA_FUNCTION_NAME e.g. centralwatch-image-processor>
# NOTE: the users table must have a GSI named "email-index" on the "email"
# attribute (the app hardcodes that GSI name — see AWS_DEPLOYMENT.md §2).

# --- OpenTelemetry (OTLP over HTTP) ---
# Use http://localhost:4318 when running on the host, or
# http://otel-collector:4318 inside the compose network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_METRICS_EXPORT_INTERVAL_MS=15000

# --- Auth (REQUIRED - the app has NO default and fails fast if empty) ---
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=<LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
TOKEN_TTL_SECONDS=86400
AWS_SECURITY_AGENT_ALLOW_REMEDIATION=false

# --- CentralWatch-owned PostgreSQL proxy store (REQUIRED) ---
PROXY_DB_HOST=proxy-db
PROXY_DB_PORT=5432
PROXY_DB_NAME=centralwatch
PROXY_DB_USER=centralwatch
PROXY_DB_PASSWORD=<LONG_RANDOM_DATABASE_PASSWORD>
# Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep this key outside the monitored AWS account. Changing it without first
# re-encrypting existing records makes stored API keys unreadable.
PROXY_SECRET_ENCRYPTION_KEY=<URL_SAFE_BASE64_ENCODED_32_BYTE_KEY>

# --- Grafana (consumed by docker-compose.aws.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<LONG_RANDOM_PASSWORD_AT_LEAST_12_CHARS>

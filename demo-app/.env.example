# ============================================================
# CentralWatch Demo App — environment variables
#
# Two profiles:
#   A) REAL AWS (recommended default): leave AWS_ENDPOINT_URL empty/unset,
#      provide real credentials (or use the instance/role credential chain),
#      pre-create the resources and set AWS_PROVISION_RESOURCES=false. The app
#      VALIDATES the resources at startup and fails fast if any are missing.
#   B) LOCALSTACK (offline dev): set AWS_ENDPOINT_URL to the emulator and
#      AWS_PROVISION_RESOURCES=true so resources are auto-created idempotently.
#
# docker-compose.yml overrides the OTLP endpoint for the container network
# (otel-collector hostname) and defaults to profile B for the dev stack.
#
# For REAL AWS, a ready-to-fill template also exists: ../.env.aws.example
# (copy to demo-app/.env for a bare uvicorn run, or to the repo-root .env for
# docker compose -f docker-compose.aws.yml substitution).
# ============================================================

# --- Application ---
SERVICE_NAME=centralwatch-demo-app
SERVICE_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- AWS connection ---
# Empty => real AWS default regional endpoints.
# LocalStack: http://localhost:4566 (host) or http://localstack:4566 (Docker).
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
# Empty => default credential chain (env vars, ~/.aws/credentials, IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# S3 addressing style: auto (SDK default — real AWS) | path (LocalStack).
AWS_S3_ADDRESSING_STYLE=auto
# true  => create missing resources idempotently at startup (LocalStack/dev)
# false => validate resources exist and fail fast (real AWS — recommended)
AWS_PROVISION_RESOURCES=false
# IAM role ARN used when creating the Lambda function (provisioning mode).
# Required on real AWS. LocalStack accepts any ARN, e.g.
# arn:aws:iam::000000000000:role/centralwatch-lambda-role
LAMBDA_ROLE_ARN=

# --- AWS resource names (must pre-exist when AWS_PROVISION_RESOURCES=false) ---
S3_BUCKET=centralwatch-files
DYNAMODB_USERS_TABLE=users
DYNAMODB_ORDERS_TABLE=orders
DYNAMODB_FILES_TABLE=files
SNS_TOPIC=centralwatch-notifications
SQS_QUEUE=centralwatch-queue
LAMBDA_FUNCTION=centralwatch-image-processor

# --- OpenTelemetry (OTLP over HTTP) ---
# Use localhost:4318 when running on the host, or http://otel-collector:4318 inside Docker.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORT_INTERVAL_MS=15000

# --- Behavior ---
INIT_RECONCILE_INTERVAL_SECONDS=60
LOCALSTACK_WAIT_TIMEOUT_SECONDS=120
SIMULATE_TIMEOUT_SECONDS=5
SIMULATE_RETRY_ATTEMPTS=3
AWS_SECURITY_AGENT_ALLOW_REMEDIATION=false
# REQUIRED - the app has NO default and fails fast at startup if this is empty.
# Local/dev: any value is fine (docker-compose.yml injects a dev-only default).
# Production: strong random secret via secrets management - never commit the real value.
AUTH_TOKEN_SECRET=
TOKEN_TTL_SECONDS=86400

# --- CentralWatch proxy database (PostgreSQL, hosted with CentralWatch) ---
PROXY_DB_HOST=localhost
PROXY_DB_PORT=5432
PROXY_DB_NAME=centralwatch
PROXY_DB_USER=centralwatch
PROXY_DB_PASSWORD=
# REQUIRED: independent AES-256 key used to encrypt upstream API keys before
# database storage. Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PROXY_SECRET_ENCRYPTION_KEY=
